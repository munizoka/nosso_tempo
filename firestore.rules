rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function gbAccessPath(uid) {
      return /databases/$(database)/documents/gabibotAccess/$(uid);
    }
    function gbIsSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function gbIsMember() {
      return request.auth != null
        && exists(gbAccessPath(request.auth.uid))
        && get(gbAccessPath(request.auth.uid)).data.role in ['admin', 'vitoria'];
    }
    function gbIsAdmin() {
      return request.auth != null
        && exists(gbAccessPath(request.auth.uid))
        && get(gbAccessPath(request.auth.uid)).data.role == 'admin';
    }
    function gbMemoryFields(data) {
      return data.keys().hasAll(['title', 'content', 'category', 'eventDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'content', 'category', 'eventDate', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.content is string && data.content.size() > 0 && data.content.size() <= 2000
        && data.category is string && data.category.size() <= 40
        && data.eventDate is string && data.eventDate.size() <= 10
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    // Progresso do Super Gabriel Bros isolado por Firebase Auth UID.
    // Nunca misturar com permissões de histórico do GabiBot.
    function sgbValidSave(data,slotId) {
      return data.keys().hasAll(['version','slotId','payload','updatedAt'])
        && data.keys().hasOnly(['version','slotId','payload','updatedAt'])
        && data.version == 1
        && data.slotId == slotId
        && data.updatedAt is timestamp
        && data.payload is map
        && data.payload.keys().hasAll([
          'version','savedAt','difficulty','level','phase','score','lives','elapsedSeconds',
          'player','checkpoint','skyCheckpoint','levelComplete','inventory',
          'collectedPickups','inventoryUnlocked','legacy'
        ])
        && data.payload.keys().hasOnly([
          'version','savedAt','difficulty','level','phase','score','lives','elapsedSeconds',
          'player','checkpoint','skyCheckpoint','levelComplete','inventory',
          'collectedPickups','inventoryUnlocked','legacy','superRemaining','coins'
        ])
        && (!('coins' in data.payload) ||
          (data.payload.coins is int && data.payload.coins >= 0 && data.payload.coins <= 9999))
        && (!('superRemaining' in data.payload) ||
          (data.payload.superRemaining is number && data.payload.superRemaining >= 0 && data.payload.superRemaining <= 12))
        && data.payload.version == 1
        && data.payload.savedAt is number
        && data.payload.difficulty in ['easy','normal','hard']
        && data.payload.level in [1,2,3]
        && data.payload.phase in ['playing','map']
        && data.payload.score is number
        && data.payload.lives is number
        && data.payload.elapsedSeconds is number
        && data.payload.player is map
        && data.payload.player.keys().hasAll(['x','y','direction'])
        && data.payload.player.keys().hasOnly(['x','y','direction'])
        && data.payload.player.x is number
        && data.payload.player.y is number
        && data.payload.player.direction in [-1,1]
        && data.payload.checkpoint is map
        && data.payload.checkpoint.keys().hasAll(['reached','x'])
        && data.payload.checkpoint.keys().hasOnly(['reached','x'])
        && data.payload.checkpoint.reached is bool
        && data.payload.checkpoint.x is number
        && data.payload.skyCheckpoint is map
        && data.payload.skyCheckpoint.keys().hasAll(['reached','x'])
        && data.payload.skyCheckpoint.keys().hasOnly(['reached','x'])
        && data.payload.skyCheckpoint.reached is bool
        && data.payload.skyCheckpoint.x is number
        && data.payload.levelComplete is map
        && data.payload.levelComplete.keys().hasAll(['1','2','3'])
        && data.payload.levelComplete.keys().hasOnly(['1','2','3'])
        && data.payload.inventory is map
        && data.payload.inventory.keys().hasAll(['version','story','consumables'])
        && data.payload.inventory.keys().hasOnly(['version','story','consumables'])
        && data.payload.inventory.version == 2
        && data.payload.inventory.story is list
        && data.payload.inventory.story.size() <= 9
        && data.payload.inventory.story.hasOnly(['medallion','drink'])
        && data.payload.inventory.consumables is map
        && data.payload.inventory.consumables.keys().hasOnly(['life','shield','speed','jump','burger'])
        && (!('burger' in data.payload.inventory.consumables) ||
          (data.payload.inventory.consumables.burger is int &&
           data.payload.inventory.consumables.burger >= 0 &&
           data.payload.inventory.consumables.burger <= 99))
        && data.payload.collectedPickups is list
        && data.payload.collectedPickups.size() <= 100
        && data.payload.inventoryUnlocked is bool
        && data.payload.legacy is bool;
    }
    match /superGabrielSaves/{userId}/slots/{slotId} {
      allow get, list: if gbIsSelf(userId);
      allow create, update: if gbIsSelf(userId)
        && slotId in ['slot1','slot2','slot3']
        && sgbValidSave(request.resource.data,slotId);
      allow delete: if false;
    }

    match /config/{docId} {
      allow get: if docId in ['avatares', 'lugares'];
      allow list: if false;
      allow create, update: if docId in ['avatares', 'lugares'] && gbIsMember();
      allow delete: if docId in ['avatares', 'lugares'] && gbIsAdmin();
    }
    match /pets/{userId} {
      allow get, create, update, delete: if gbIsSelf(userId);
      allow list: if false;
    }
    match /gabibotAccess/{userId} {
      allow get: if gbIsSelf(userId);
      allow list, create, update, delete: if false;
    }
    match /gabibotSharedMemories/{memoryId} {
      allow get, list: if gbIsMember();
      allow create: if gbIsAdmin() && gbMemoryFields(request.resource.data);
      allow update: if gbIsAdmin() && gbMemoryFields(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if gbIsAdmin();
    }
    match /gabibotChatSettings/{userId} {
      allow get: if gbIsSelf(userId) && gbIsMember();
      allow list: if false;
      allow create, update: if gbIsSelf(userId) && gbIsMember()
        && request.resource.data.keys().hasAll(['saveHistory', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['saveHistory', 'updatedAt'])
        && request.resource.data.saveHistory is bool
        && request.resource.data.updatedAt is timestamp;
      allow delete: if gbIsSelf(userId) && gbIsMember();
    }
    match /gabibotChats/{userId}/messages/{messageId} {
      allow get, list, delete: if gbIsSelf(userId) && gbIsMember();
      allow create: if gbIsSelf(userId) && gbIsMember()
        && exists(/databases/$(database)/documents/gabibotChatSettings/$(userId))
        && get(/databases/$(database)/documents/gabibotChatSettings/$(userId)).data.saveHistory == true
        && request.resource.data.keys().hasAll(['role', 'text', 'seq', 'createdAt'])
        && request.resource.data.keys().hasOnly(['role', 'text', 'seq', 'createdAt'])
        && request.resource.data.role in ['user', 'model']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 3500
        && request.resource.data.seq is int
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
    }
  }
}
